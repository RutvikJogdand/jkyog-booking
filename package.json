{
  "name": "jkyog-booking",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:browser": "playwright test",
    "test:integration": "node --env-file=.env.test.local scripts/migrate.mjs TEST_DATABASE_URL_UNPOOLED && jest -c jest.integration.config.mjs --runInBand",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@opentelemetry/api": "1.10.0",
    "@vercel/functions": "3.10.5",
    "next": "16.4.4",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "overrides": {
    "zod": "$zod"
  }
}
