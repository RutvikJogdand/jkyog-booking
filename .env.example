# .env.local — written by `neon env pull` (or `neon deploy`). Never commit real values.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# .env.test.local — the Neon "test" branch, used only by `npm run test:integration`.
# Get them with `neon connection-string test --pooled` and `neon connection-string test`.
TEST_DATABASE_URL=
TEST_DATABASE_URL_UNPOOLED=
# Required before the integration suite deletes bookings and resets stock.
# Set this only on a disposable local or dedicated Neon test branch.
TEST_DATABASE_IS_DISPOSABLE=
